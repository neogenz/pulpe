/**
 * Pulpe — Épargne : objectifs & progression
 *
 * Vision métier des workflows. Statut : fondation, progression, simulateur et
 * auto-décomposition (PUL-285) implémentés.
 *  - l'auto-décomposition crée des budget_line one_off bornées dans les
 *    budgets déjà matérialisés — jamais de récurrence sur le Mois Type ;
 *  - la progression à 2 couches et l'application explicite du simulateur sont livrées.
 *
 * Le retrait (PUL-329) est la seule sortie de stock : un Revenu libre déclare son
 * objectif d'origine, le solde baisse, le plan futur reste intact.
 *
 * Tags : #foundation · #progression · #simulator · #automation · #withdrawal.
 */

specification {
  element actor {
    style {
      shape person
    }
  }
  element app {
    style {
      color sky
    }
  }
  element screen {
    style {
      color indigo
    }
  }
  element service {
    style {
      color green
    }
  }
  element usecase {
    style {
      color green
      shape rectangle
    }
  }
  element datastore {
    style {
      color slate
    }
  }
  element store {
    style {
      color slate
      shape cylinder
    }
  }

  tag foundation
  tag progression
  tag simulator
  tag automation
  tag withdrawal
}

model {
  user = actor "Utilisateur" {
    description "Veut suivre un objectif d'épargne à long terme sans recalculer sa progression à la main."
  }

  ios = app "App iOS" {
    description "Plateforme primaire. Objectifs est un tab principal ; la carte Épargne reste un raccourci secondaire."

    dashboardCard = screen "Carte Épargne (dashboard)" {
      #foundation
      description "Résumé mensuel existant, devient tappable → liste des objectifs."
    }
    goalsList = screen "Liste des objectifs" {
      #foundation
    }
    goalForm = screen "Formulaire objectif (créer / éditer)" {
      #foundation
    }
    lineEditor = screen "Éditeur ligne Épargne (+ picker objectif)" {
      #foundation
    }
    goalDetail = screen "Détail objectif + progression" {
      #progression
      description "Barre prévu/confirmé, rythme, avance/retard — ton non-anxiogène. Section Retraits séparée des contributions."
    }
    addTransaction = screen "Ajouter une transaction" {
      #withdrawal
      description "Un Revenu peut déclarer son origine : « Ce revenu vient d'un objectif d'épargne », avec aperçu disponible → restant."
    }
    transactionDetail = screen "Détail / édition transaction" {
      #withdrawal
      description "Contexte source complet : lien actif navigable, ou état cassé nommé sans navigation. Aucun sélecteur de source."
    }
  }

  web = app "App Web" {
    description "Desktop-first. Parité fonctionnelle, mêmes endpoints, route dédiée /savings-goals."
  }

  backend = service "Backend NestJS" {
    goalCrud = usecase "CRUD objectifs" {
      #foundation
      description "POST/GET/PATCH/DELETE. DELETE délie les lignes (savings_goal_id = null), ne supprime aucune ligne. PAUSED/COMPLETED stoppent la génération des lignes liées dans les nouveaux budgets (PUL-285 CA5)."
    }
    lineLink = usecase "Lien ligne ↔ objectif" {
      #foundation
      description "Tagging manuel via savings_goal_id sur template_line (primaire) ou budget_line (kind=saving)."
    }
    pointage = usecase "Saisie transaction + pointage" {
      #foundation
      description "Flow mensuel existant. checkedAt = réconciliation, le « confirmé »."
    }
    goalProgress = usecase "Progression /:id/progress" {
      #progression
      description "Cumul multi-mois, % atteint, rythme, requis, projeté. Déchiffrement backend."
    }
    goalDecompose = usecase "Auto-décompose → lignes bornées" {
      #automation
      description "Reste à épargner / mois restants (payDay-aware, arrondi centime sup) → budget_line one_off liée dans chaque période déjà budgétée, jusqu'à l'échéance incluse. Le Mois Type reste intact."
    }
    goalReproject = usecase "Appliquer un plan simulé" {
      #simulator
      description "Valide et applique atomiquement les montants confirmés. Ne modifie jamais le Mois Type."
    }
    withdrawalOptions = usecase "Objectifs éligibles au retrait" {
      #withdrawal
      description "GET /savings-goals/withdrawal-options. Lecture groupée, soldes déchiffrés, filtre confirmed > 0 quel que soit le statut."
    }
    withdrawalWrite = usecase "Écrire un revenu lié" {
      #withdrawal
      description "Le module transaction reste propriétaire de l'écriture. Il compare le montant converti au solde, chiffre, puis appelle la RPC atomique avec la révision lue."
    }
    withdrawalHistory = usecase "Historique des retraits" {
      #withdrawal
      description "GET /savings-goals/:id/withdrawals. Trié du plus récent au plus ancien, montants déchiffrés."
    }
    encryption = service "Encryption AES-256-GCM" {
      description "Chiffre target_amount, initial_amount et original_target_amount à l'écriture, puis déchiffre avant calcul et sérialisation."
    }
  }

  db = datastore "Supabase (Postgres + RLS)" {
    goalTable = store "savings_goal" {
      description "name, target_amount et initial_amount chiffrés, target_date, status. balance_revision versionne tout changement susceptible de périmer le solde. Colonnes FX nulles dans la devise du compte."
    }
    lineTable = store "budget_line" {
      description "savings_goal_id (nullable) = le lien. amount chiffré, checked_at = pointage."
    }
    txTable = store "transaction" {
      description "Opérations réelles d'épargne, rattachées à une ligne. source_savings_goal_id (FK ON DELETE SET NULL) + source_savings_goal_name portent l'origine d'un Revenu libre."
    }
  }

  // ── Relations structurelles (landscape) ──
  user -> ios "utilise (primaire)"
  user -> web "utilise (desktop)"
  ios -> backend "API REST"
  web -> backend "API REST (parité)"
  backend -> db "lit / écrit — chiffré, RLS par user_id"
  backend.goalCrud -> backend.encryption "chiffre target_amount"
  backend.goalProgress -> backend.encryption "déchiffre montants"
  backend.withdrawalWrite -> backend.encryption "chiffre le montant retiré"
  backend.withdrawalOptions -> backend.encryption "déchiffre les soldes"
}

views {
  view index {
    title "Épargne — Vue d'ensemble du produit"
    include *
    include ios.*
    include backend.*
    include db.*

    style element.tag = #progression {
      color indigo
    }
    style element.tag = #automation {
      color amber
    }
    style element.tag = #simulator {
      color green
    }
    style element.tag = #withdrawal {
      color red
    }
  }

  dynamic view createGoal {
    title "Workflow 1 — Créer un objectif (fondation · rattachement manuel)"
    user -> ios.goalForm "saisit nom, montant cible, montant de départ, échéance"
    ios.goalForm -> backend.goalCrud "POST /savings-goals (devise du compte)"
    backend.goalCrud -> backend.encryption "chiffre target_amount et initial_amount"
    backend.goalCrud -> db.goalTable "INSERT — status ACTIVE, FX null"
    backend.goalCrud -> ios.goalsList "objectif créé, apparaît dans la liste"
  }

  dynamic view linkLine {
    title "Workflow 2 — Rattacher une ligne Épargne à un objectif"
    user -> ios.lineEditor "crée/édite une ligne Épargne (kind=saving) + choisit l'objectif (picker optionnel)"
    ios.lineEditor -> backend.lineLink "tag savingsGoalId (Mois Type primaire, ou budget_line ponctuel)"
    backend.lineLink -> db.lineTable "UPDATE savings_goal_id"
    backend.lineLink -> ios.goalDetail "la ligne compte désormais dans l'objectif"
  }

  dynamic view monthlyContribution {
    title "Workflow 3 — Contribution mensuelle (le geste récurrent)"
    user -> ios.dashboardCard "ouvre Pulpe — flow quotidien intact"
    user -> ios.lineEditor "vire l'argent → saisit la transaction Épargne + pointe"
    ios.lineEditor -> backend.pointage "transaction (saving) + checkedAt"
    backend.pointage -> db.txTable "INSERT transaction"
    backend.pointage -> db.lineTable "UPDATE checked_at"
    backend.pointage -> ios.goalDetail "cumul prévu / confirmé mis à jour"
  }

  dynamic view trackProgress {
    title "Workflow 4 — Consulter la progression (prévu vs confirmé)"
    user -> ios.dashboardCard "tap « Voir mes objectifs »"
    ios.dashboardCard -> ios.goalsList "ouvre la liste"
    user -> ios.goalsList "tap un objectif"
    ios.goalsList -> ios.goalDetail "ouvre le détail"
    ios.goalDetail -> backend.goalProgress "GET /:id/progress"
    backend.goalProgress -> db.lineTable "Somme des lignes Épargne liées (tous les mois)"
    backend.goalProgress -> db.txTable "transactions pointées"
    backend.goalProgress -> backend.encryption "déchiffre les montants"
    backend.goalProgress -> ios.goalDetail "prévu cumulé · dont confirmé · rythme · avance/retard"
  }

  dynamic view autoDecompose {
    title "Workflow 5 — Auto-décomposition à la création"
    user -> ios.goalForm "crée « Maison 100k / 48 mois », mensualité pré-remplie éditable"
    ios.goalForm -> backend.goalCrud "POST + monthlyContribution (opt-in)"
    backend.goalCrud -> backend.goalDecompose "pose la baseline choisie (2083.34 / mois)"
    backend.goalDecompose -> db.lineTable "crée une budget_line one_off liée dans chaque budget existant, du mois courant à l'échéance"
    backend.goalDecompose -> ios.goalDetail "objectif + prévisions bornées ; les mois non budgétés restent des trous du plan"
  }

  dynamic view withdrawFromGoal {
    title "Workflow 7 — Utiliser un objectif comme source d'un revenu"
    user -> ios.addTransaction "ajoute un Revenu et active « Ce revenu vient d'un objectif d'épargne »"
    ios.addTransaction -> backend.withdrawalOptions "GET withdrawal-options (soldes disponibles)"
    backend.withdrawalOptions -> ios.addTransaction "objectifs éligibles, solde et devise du compte"
    user -> ios.addTransaction "saisit le montant — aperçu disponible → restant"
    ios.addTransaction -> backend.withdrawalWrite "POST /transactions avec sourceSavingsGoalId"
    backend.withdrawalWrite -> db.goalTable "verrouille l'objectif et compare la révision lue"
    backend.withdrawalWrite -> db.txTable "INSERT revenu chiffré + tags, atomiquement"
    backend.withdrawalWrite -> ios.goalDetail "solde recalculé, retrait visible dans l'historique"
  }

  dynamic view browseWithdrawals {
    title "Workflow 8 — Naviguer entre un retrait et sa transaction"
    user -> ios.goalDetail "ouvre la section Retraits"
    ios.goalDetail -> backend.withdrawalHistory "GET /:id/withdrawals"
    backend.withdrawalHistory -> db.txTable "revenus liés, triés du plus récent au plus ancien"
    backend.withdrawalHistory -> ios.goalDetail "date, libellé, montant, budget et transaction"
    user -> ios.goalDetail "touche un retrait"
    ios.goalDetail -> ios.transactionDetail "ouvre la transaction dans son budget"
    ios.transactionDetail -> ios.goalDetail "lien actif : retour vers l'objectif. Objectif supprimé : contexte cassé nommé, sans navigation"
  }

  dynamic view redistribution {
    title "Workflow 6 — Simuler puis appliquer un plan"
    user -> ios.goalDetail "ouvre Ajuster mon plan"
    ios.goalDetail -> backend.goalProgress "charge timeline, rythme et mois provisionnables"
    ios.goalDetail -> user "simule localement sans écriture"
    user -> ios.goalDetail "confirme le récapitulatif"
    ios.goalDetail -> backend.goalReproject "POST /:id/plan avec les ajustements"
    backend.goalReproject -> db.lineTable "provisionne si nécessaire puis applique atomiquement"
    backend.goalReproject -> ios.goalDetail "recharge la progression et les budgets"
  }
}
