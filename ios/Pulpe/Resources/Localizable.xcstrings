    },
    "On ne le recalcule plus, même si le taux bouge." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir rechnen ihn nicht mehr neu, auch wenn sich der Kurs bewegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We stop recalculating it, even if the rate moves."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non lo ricalcoliamo più, anche se il cambio si muove."
          }
        }
      }
    },
    "On répartit ce montant à parts égales sur les mois que tu choisis, à partir de ce mois-ci. Désélectionne ceux à sauter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betrag wird gleichmässig auf die Monate verteilt, die du wählst, ab diesem Monat. Wähle die Monate ab, die übersprungen werden sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This amount is split evenly across the months you pick, starting this month. Deselect the ones to skip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importo viene suddiviso in parti uguali sui mesi che scegli, a partire da questo mese. Deseleziona quelli da saltare."
          }
        }
      }
    },
    "On répartit cette dépense sur les mois que tu choisis. Désélectionne ceux à sauter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgabe wird auf die Monate verteilt, die du wählst. Wähle die Monate ab, die übersprungen werden sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This expense is split across the months you pick. Deselect the ones to skip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La spesa viene suddivisa sui mesi che scegli. Deseleziona quelli da saltare."
          }
        }
      }
    },
    "On répartit cette prévision de %@ en %@ par mois sur %lld mois." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Planposten von %@ wird in %@ pro Monat auf %lld Monate aufgeteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This planned item of %@ is split into %@ per month over %lld months."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On répartit cette prévision de %1$@ en %2$@ par mois sur %3$lld mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa previsione di %@ viene suddivisa in %@ al mese su %lld mesi."
          }
        }
      }
    },
    "On te fait signe le jour de paie ?" : {},
    "On transforme cette dépense de %@ en un plan lissé : %@ par mois sur %lld mois. Le réel est remplacé par le plan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgabe von %@ wird zu einem verteilten Plan: %@ pro Monat auf %lld Monate. Das Tatsächliche wird durch den Plan ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This expense of %@ becomes a spread plan: %@ per month over %lld months. The actual is replaced by the plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On transforme cette dépense de %1$@ en un plan lissé : %2$@ par mois sur %3$lld mois. Le réel est remplacé par le plan."
