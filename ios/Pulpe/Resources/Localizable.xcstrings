      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour brancher un nouvel assistant, ouvre Pulpe sur le web, dans Paramètres puis Connexions. Tu choisis ses droits et tu valides avec ton code PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To connect a new assistant, open Pulpe on the web, in Settings then Connections. You choose its rights and confirm with your PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen neuen Assistenten zu verbinden, öffne Pulpe im Web unter Einstellungen, dann Verbindungen. Du wählst seine Rechte und bestätigst mit deinem PIN-Code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per collegare un nuovo assistente, apri Pulpe sul web, in Impostazioni poi Connessioni. Scegli i suoi diritti e confermi con il tuo codice PIN."
          }
        }
      }
    },
