          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo importo alimenterà il tuo salvadanaio ogni mese, senza scadenza imposta."
          }
        }
      }
    },
    "Ce montant dépasse ce que contient l'objectif." : {
