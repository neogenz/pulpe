          }
        }
      }
    },
    "Si tu oublies ton code, cette clé est le seul moyen de retrouver tes montants. Ça prend une minute." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you forget your code, this key is the only way to get your amounts back. It takes a minute."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du deinen Code vergisst, ist dieser Schlüssel die einzige Möglichkeit, deine Beträge zurückzubekommen. Es dauert eine Minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dimentichi il tuo codice, questa chiave è l'unico modo per ritrovare i tuoi importi. Ci vuole un minuto."
          }
        }
      }
    },
    "Créer ma clé" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
