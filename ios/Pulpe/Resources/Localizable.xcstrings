    "Associe à ton compte les événements techniques et erreurs pour comprendre les problèmes et t’aider plus rapidement. Aucun montant ni contenu saisi n’est collecté." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpft technische Ereignisse und Fehler mit deinem Konto, damit Probleme verständlich werden und du schneller Hilfe bekommst. Beträge und Eingaben werden nicht erfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links technical events and errors to your account, so problems are easier to understand and help reaches you faster. No amounts and nothing you type are collected."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega al tuo account gli eventi tecnici e gli errori, per capire i problemi e aiutarti più in fretta. Non raccogliamo importi né ciò che scrivi."
          }
        }
      }
    },
    "Assurance & Abonnements" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versicherung & Abos"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insurance & Subscriptions"
          }
        },
        "it" : {
