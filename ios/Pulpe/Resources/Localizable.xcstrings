    "Un café, un plein, des courses : note-la dès qu'elle passe. Ton « disponible à dépenser » se met à jour aussitôt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kaffee, Tanken, Einkäufe: Erfasse sie, sobald sie anfällt. Dein „Verfügbar zum Ausgeben“ passt sich sofort an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coffee, fuel, groceries: note it as soon as it happens. Your “available to spend” updates right away."
