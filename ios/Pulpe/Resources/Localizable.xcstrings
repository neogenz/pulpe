          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota cosa passa sul tuo conto per seguire il tuo risparmio"
          }
        }
      }
    },
    "Note cette clé dans un endroit sûr. Elle te permettra de retrouver l'accès à tes données si tu oublies ton code PIN." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiere diesen Schlüssel an einem sicheren Ort. Damit kommst du wieder an deine Daten, falls du deinen PIN-Code vergisst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write this key down somewhere safe. It will let you get back into your data if you forget your PIN."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota questa chiave in un posto sicuro. Ti permetterà di riaccedere ai tuoi dati se dimentichi il tuo codice PIN."
          }
        }
      }
    },
    "Note ta première dépense" : {
      "localizations" : {
        "de" : {
