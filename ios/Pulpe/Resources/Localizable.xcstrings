        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session expired — sign in again to continue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessione scaduta — accedi di nuovo per continuare"
          }
        }
      }
    },
    "Seul l'objectif sera supprimé. Tout le reste sera conservé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Sparziel wird gelöscht. Alles andere bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the goal will be deleted. Everything else stays."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà eliminato solo l'obiettivo. Tutto il resto rimane."
