            "value" : "Annota cosa passa sul tuo conto per seguire le tue spese"
          }
        }
      }
    },
    "Note ce qui passe sur ton compte pour suivre tes revenus" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
