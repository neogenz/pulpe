            "value" : "Questo mese"
          }
        }
      }
    },
    "Ce montant alimentera ton pot chaque mois, sans échéance imposée." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Betrag fliesst jeden Monat in deinen Topf, ohne feste Frist."
