    "Pulpe, ouvre l'app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulpe, öffnet die App"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulpe, opens the app"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulpe, apre l'app"
          }
        }
      }
    },
    "Quand tu dépenses moins que prévu, Pulpe garde le montant prévu pour protéger ton budget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du weniger ausgibst als geplant, behält Pulpe den geplanten Betrag, um dein Budget zu schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you spend less than planned, Pulpe keeps the planned amount to protect your budget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando spendi meno del previsto, Pulpe mantiene l'importo previsto per proteggere il tuo budget."
          }
        }
      }
    },
    "Quand un mouvement est passé sur ton compte, pointe-le ici pour garder le fil." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Bewegung über dein Konto gelaufen ist, hake sie hier ab, um den Überblick zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When activity has gone through your account, check it off here to stay on track."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando un movimento è passato sul tuo conto, spuntalo qui per non perdere il filo."
          }
        }
      }
    },
    "Que veux-tu supprimer ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was willst du löschen?"
