    "Activé, un choix de devise apparaît à côté du montant quand tu ajoutes une dépense ou un revenu. Pulpe convertit au cours du jour." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé, un choix de devise apparaît à côté du montant quand tu ajoutes une dépense ou un revenu. Pulpe convertit au cours du jour."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, a currency choice appears next to the amount when you add an expense or an income. Pulpe converts at the day's rate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, erscheint neben dem Betrag eine Währungsauswahl, sobald du eine Ausgabe oder ein Einkommen hinzufügst. Pulpe rechnet zum Tageskurs um."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, accanto all'importo compare la scelta della valuta quando aggiungi una spesa o un'entrata. Pulpe converte al cambio del giorno."
          }
        }
      }
    },
