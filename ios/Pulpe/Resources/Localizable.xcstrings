    "Noté comme dépense pointée, cet ajustement aligne ton solde pointé sur tes comptes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als abgehakte Ausgabe erfasst, gleicht diese Anpassung deinen abgehakten Saldo an deine Konten an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded as a checked expense, this adjustment lines your checked balance up with your accounts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrato come spesa spuntata, questo aggiustamento allinea il tuo saldo spuntato ai tuoi conti."
          }
        }
      }
    },
    "Noté comme revenu pointé, cet ajustement aligne ton solde pointé sur tes comptes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als abgehakte Einnahme erfasst, gleicht diese Anpassung deinen abgehakten Saldo an deine Konten an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded as a checked income, this adjustment lines your checked balance up with your accounts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrato come entrata spuntata, questo aggiustamento allinea il tuo saldo spuntato ai tuoi conti."
          }
        }
      }
    },
