    "Note ce qui passe sur ton compte pour suivre tes dépenses" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte fest, was auf deinem Konto passiert, um deine Ausgaben zu verfolgen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note what goes through your account to track your expenses"
          }
        },
        "it" : {
          "stringUnit" : {
