    "Tes charges dépassent à elles seules tes revenus. Revois-les pour tout faire tenir." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your charges alone exceed your income. Review them to make everything fit."
