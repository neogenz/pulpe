    "Ton coffre est configuré sans clé de récupération. Génère-la maintenant pour éviter de perdre l'accès à tes données chiffrées." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tresor ist ohne Wiederherstellungsschlüssel eingerichtet. Erzeuge ihn jetzt, damit du den Zugang zu deinen verschlüsselten Daten nicht verlierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vault is set up without a recovery key. Create it now to avoid losing access to your encrypted data."
