    "Dès que tu dépenses, pointe-le en un tap. 10 secondes, et ton « disponible à dépenser » reste toujours juste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du etwas ausgibst, hak es mit einem Tipp ab. 10 Sekunden, und dein „Verfügbar zum Ausgeben“ bleibt immer aktuell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as you spend, check it off in one tap. 10 seconds, and your “available to spend” always stays accurate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appena spendi, spuntalo con un tocco. 10 secondi, e il tuo «disponibile da spendere» resta sempre giusto."
          }
        }
      }
    },
