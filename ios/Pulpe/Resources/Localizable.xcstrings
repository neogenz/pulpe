    "Selected: %@" : {
      "localizations" : {},
      "shouldTranslate" : false
    },
    "Ses prévisions (%lld) et ses mouvements (%lld) seront supprimés. Cette action est irréversible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Planposten (%lld) und seine Bewegungen (%lld) werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its planned items (%lld) and its activity (%lld) will be deleted. This can't be undone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue previsioni (%lld) e i suoi movimenti (%lld) verranno eliminati. Non si può tornare indietro."
          }
        }
      }
    },
    "Session expirée — reconnecte-toi pour continuer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzung abgelaufen — melde dich neu an, um fortzufahren"
