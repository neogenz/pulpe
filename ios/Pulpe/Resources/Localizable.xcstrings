            "value" : "Wenn eine Bewegung über dein Konto gelaufen ist, hake sie hier ab, um den Überblick zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When activity has gone through your account, check it off here to stay on track."
