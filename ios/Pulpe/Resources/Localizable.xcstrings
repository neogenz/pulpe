        }
      }
    },
    "Note ce qui passe sur ton compte pour suivre ton épargne" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte fest, was auf deinem Konto passiert, um dein Sparen zu verfolgen"
          }
        },
