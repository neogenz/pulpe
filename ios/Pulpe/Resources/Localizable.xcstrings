          }
        }
      }
    },
    "%lld caractères sur %lld. Tirets facultatifs." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld of %lld characters. Dashes optional."
          }
        },
