    "%@ est en pause. %lld prévisions Épargne lui restent liées sur tes mois futurs. Que veux-tu en faire ?" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ est en pause. %lld prévision Épargne lui reste liée sur tes mois futurs. Que veux-tu en faire ?"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ est en pause. %lld prévisions Épargne lui restent liées sur tes mois futurs. Que veux-tu en faire ?"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ is paused. %2$lld Savings forecast is still linked to it in your future months. What do you want to do with it?"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ is paused. %2$lld Savings forecasts are still linked to it in your future months. What do you want to do with them?"
