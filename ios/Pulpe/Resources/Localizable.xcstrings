    "Voyage, appart, coussin de sécurité… donne-lui un montant et une date. Je calcule ce qu'il faut mettre de côté chaque mois, et je te dis où tu en es." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyage, appart, coussin de sécurité… donne-lui un montant et une date. Je calcule ce qu'il faut mettre de côté chaque mois, et je te dis où tu en es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trip, a flat, a safety cushion… give it an amount and a date. I work out what to set aside each month, and I tell you where you stand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reise, Wohnung, Notgroschen… gib ihm einen Betrag und ein Datum. Ich rechne aus, was du jeden Monat zur Seite legen musst, und sage dir, wo du stehst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaggio, casa, cuscinetto di sicurezza… dagli un importo e una data. Calcolo quanto mettere da parte ogni mese e ti dico a che punto sei."
          }
        }
      }
    },
    "Exemple d'objectif Voyage : %@ sur %@, %@ par mois jusqu'en %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemple d'objectif Voyage : %@ sur %@, %@ par mois jusqu'en %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Example Travel goal: %1$@ of %2$@, %3$@ per month until %4$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispielziel Reise: %1$@ von %2$@, %3$@ pro Monat bis %4$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiettivo di esempio Viaggio: %1$@ su %2$@, %3$@ al mese fino a %4$@"
          }
        }
      }
    },
