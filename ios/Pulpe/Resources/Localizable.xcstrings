    "%@" : {},
    "%@\n\n« Appliquer » mettra à jour les budgets en cours et futurs. Les catégories modifiées manuellement ne seront pas affectées." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n„Anwenden“ aktualisiert laufende und künftige Budgets. Manuell angepasste Posten bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n“Apply” will update current and future budgets. Manually edited items won’t be affected."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n“Applica” aggiornerà i budget in corso e futuri. Le voci modificate a mano non saranno toccate."
          }
        }
      }
    },
    "%@ " : {},
