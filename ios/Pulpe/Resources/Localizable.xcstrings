    "Quand tu dépenses moins que prévu, Pulpe garde le montant prévu pour protéger ton budget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du weniger ausgibst als geplant, behält Pulpe den geplanten Betrag, um dein Budget zu schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you spend less than planned, Pulpe keeps the planned amount to protect your budget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando spendi meno del previsto, Pulpe mantiene l'importo previsto per proteggere il tuo budget."
          }
        }
      }
    },
    "Quand un mouvement est passé sur ton compte, pointe-le ici pour garder le fil." : {
      "localizations" : {
