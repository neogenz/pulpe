    "« Depuis » reprend la devise du compte ; « Vers » affiche l’équivalent calculé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Von“ übernimmt die Kontowährung; „Nach“ zeigt den berechneten Gegenwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“From” uses your account currency; “To” shows the calculated equivalent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Da» riprende la valuta del conto; «A» mostra l’equivalente calcolato."
          }
        }
      }
    },
