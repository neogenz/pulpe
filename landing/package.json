{
  "name": "pulpe-landing",
  "version": "0.47.1",
  "private": true,
  "type": "module",
  "browserslist": [
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 15",
    "Edge >= 100",
    "iOS >= 15",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "verify:agents": "node scripts/verify-agent-readiness.js",
    "test": "tsx --test --experimental-test-module-mocks app/accessibility.test.tsx app/agent-readiness.test.tsx components/guides/ArticleLayout.test.tsx content/dictionaries.test.ts data/releases.test.ts lib/amount.test.ts lib/budgetCalculator.test.ts lib/visitorCurrency.test.ts lib/bodyScrollLock.test.ts scripts/create-release.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"{app,components,content,lib,scripts}/**/*.{ts,tsx,css}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"{app,components,content,lib,scripts}/**/*.{ts,tsx,css}\" \"*.{ts,json}\"",
    "type-check": "tsc --noEmit",
    "generate:og": "npx tsx scripts/generate-og-image.ts",
    "create:release": "node scripts/create-release.js"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "negotiator": "1.0.0",
    "next": "^16.3.1",
    "posthog-js": "^1.407.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "satori": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
