{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Edit",
      "Bash(ls *)",
      "Bash(git *)",
      "WebFetch(domain:*)",
      "mcp__supabase",
      "mcp__vercel",
      "mcp__angular-cli",
      "Bash(railway *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-env-on-worktree-start.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
