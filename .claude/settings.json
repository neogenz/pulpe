{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/setup-worktree.sh\"",
            "timeout": 300,
            "statusMessage": "Setting up worktree"
          }
        ]
      }
    ]
  }
}
