    },
    "07-objectifs-epargne.png": {
      "launch_args": ["-hasSeenSavingsGoalsIntro", "YES"],
      "launch_env": { "UITEST_CAPTURE_TAB": "savings-goals" },
      "actions": [],
      "expect": "savingsGoalsListRoot"
    },
    "08-objectif-macbook-pro.png": {
      "launch_args": ["-hasSeenSavingsGoalsIntro", "YES"],
      "launch_env": { "UITEST_CAPTURE_TAB": "savings-goals" },
      "ready": "savingsGoalsListRoot",
      "actions": [{ "tap_id": "savingsGoalRow-aaaaaaaa-2222-2222-8222-222222222222" }],
      "expect": "savingsGoalDetailRoot"
    }
