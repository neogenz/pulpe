    },
    "02-vue-annuelle.png": {
      "launch_env": { "UITEST_CAPTURE_TAB": "budgets" },
      "actions": [],
      "expect": "budgetCard-22222222-0008-4026-a008-888888888888"
    },
    "03-modeles.png": {
      "launch_env": { "UITEST_CAPTURE_TAB": "templates" },
      "actions": [],
      "expect": "templateRow-aaaa1111-aaaa-1111-aaaa-111111111111"
    },
    "04-modele-budget-mensuel-standard.png": {
      "launch_env": { "UITEST_CAPTURE_TAB": "templates" },
      "ready": "templateRow-aaaa1111-aaaa-1111-aaaa-111111111111",
      "actions": [{ "tap_id": "templateRow-aaaa1111-aaaa-1111-aaaa-111111111111" }],
      "expect": "templateDetailsRoot"
    },
    "05-prevu-vs-reel.png": {
      "launch_env": { "UITEST_CAPTURE_TAB": "budgets" },
      "ready": "budgetCard-22222222-0008-4026-a008-888888888888",
