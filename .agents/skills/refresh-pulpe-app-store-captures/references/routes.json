{
  "version": 1,
  "bundle_id": "app.pulpe.ios",
  "device_name": "Pulpe App Store Captures",
  "device_type": "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max",
  "runtime": "com.apple.CoreSimulator.SimRuntime.iOS-26-5",
  "width": 1320,
  "height": 2868,
  "screens": {
    "01-accueil.png": {
      "launch_args": ["-UITEST_CONTEXTUAL_CREATION_HOME"],
      "launch_env": {
        "UITEST_COLOR_SCHEME": "light",
