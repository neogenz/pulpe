{
  "name": "pulpe-android",
  "version": "0.47.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --android",
    "start": "expo start",
    "native:generate": "expo prebuild --platform android",
    "build": "expo export --platform android",
    "eas-build-post-install": "pnpm --filter pulpe-shared build",
    "test:e2e": "maestro test maestro/smoke.yaml",
    "test": "jest --coverage --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "quality": "pnpm run type-check && pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.19",
    "expo-application": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "i18n-js": "^4.5.3",
    "lottie-react-native": "~7.3.8",
    "posthog-react-native": "^4.66.0",
    "pulpe-shared": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-paper": "^5.15.3",
    "react-native-quick-crypto": "1.1.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "victory-native": "^41.26.0",
    "zod": "4.1.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  }
