{
  "expo": {
    "name": "Pulpe",
    "slug": "pulpe",
    "version": "0.43.0",
    "orientation": "portrait",
    "scheme": "pulpe",
    "android": {
      "package": "app.pulpe.android",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.pulpe.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
