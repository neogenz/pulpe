# Copy to android/.env, then restart Metro with --clear.
# Metro inlines EXPO_PUBLIC_* at build time, so a changed value needs a restart.

# local | preview | production
EXPO_PUBLIC_APP_ENV=local

# The Android emulator resolves `localhost` to itself, not to this machine.
# `adb reverse tcp:3000 tcp:3000 && adb reverse tcp:54321 tcp:54321` forwards
# both ports, which keeps these URLs identical to the webapp's.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
