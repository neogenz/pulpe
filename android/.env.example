# Copy to android/.env, then restart Metro with --clear.
# Metro inlines EXPO_PUBLIC_* at build time, so a changed value needs a restart.

# local | preview | production
EXPO_PUBLIC_APP_ENV=local

# The Android emulator resolves `localhost` to itself, not to this machine.
# `adb reverse tcp:3000 tcp:3000 && adb reverse tcp:54321 tcp:54321` forwards
# both ports, which keeps these URLs identical to the webapp's.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The OAuth *web* client ID of the Firebase/Google Cloud project — not the
# Android one, which the SDK finds by itself from the package name and the
# signing certificate. It is the only switch behind "Continuer avec Google":
# `isGoogleSignInAvailable` reads it, and the button is absent wherever it is
# unset. So a build profile that omits it ships an app with no Google sign-in
# and says nothing about it — set it in `eas env` for preview and production.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Telemetry. Optional everywhere, and off here on purpose: a development build
# measures nothing and reports nothing. `eas.json` carries the real values, and
# only its production profile turns PostHog on — same split as `ios/Config`.
# EXPO_PUBLIC_POSTHOG_ENABLED=false
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
